{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tinycast-stocks",
  "title": "Stocks",
  "description": "Google Finance quotes, charts and news",
  "icon": "extension-icon.png",
  "author": "kambaldhage",
  "platforms": [
    "macOS"
  ],
  "categories": [
    "Finance"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Stocks",
      "description": "Search stocks and view quote, chart and news",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.11"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "test": "vitest run",
    "live-check": "tsx scripts/live-check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
